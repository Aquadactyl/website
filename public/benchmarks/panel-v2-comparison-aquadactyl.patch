@@ -0,0 +1,45 @@
+import http from "@/api/http";
+import {
+  getServerFolders,
+  saveServerFolder,
+  deleteServerFolder,
+  assignServerFolder,
+} from "./serverFolders";
+vi.mock("@/api/http");
+afterEach(() => vi.clearAllMocks());
+it("loads personal folders", async () => {
+  vi.mocked(http.get).mockResolvedValue({
+    data: { data: [{ id: 1, name: "Games" }] },
+  });
+  expect(await getServerFolders()).toEqual([{ id: 1, name: "Games" }]);
+  expect(http.get).toHaveBeenCalledWith("/api/client/account/server-folders");
+});
+it("creates renames deletes and clears server folders", async () => {
+  await saveServerFolder("Games");
+  expect(http.post).toHaveBeenCalledWith("/api/client/account/server-folders", {
+    name: "Games",
+  });
+  await saveServerFolder("Updated", 1);
+  expect(http.put).toHaveBeenCalledWith(
+    "/api/client/account/server-folders/1",
+    { name: "Updated" },
+  );
+  await deleteServerFolder(1);
+  expect(http.delete).toHaveBeenCalledWith(
+    "/api/client/account/server-folders/1",
+  );
+  await assignServerFolder("uuid", 1);
+  expect(http.put).toHaveBeenCalledWith(
+    "/api/client/account/server-folders/servers/uuid",
+    { folder_id: 1 },
+  );
+  await assignServerFolder("uuid", null);
+  expect(http.put).toHaveBeenLastCalledWith(
+    "/api/client/account/server-folders/servers/uuid",
+    { folder_id: null },
+  );
+});
+it("propagates request failures", async () => {
+  vi.mocked(http.post).mockRejectedValueOnce(new Error("Failed"));
+  await expect(saveServerFolder("Games")).rejects.toThrow("Failed");
+});
diff --git a/resources/scripts/api/serverFolders.ts b/resources/scripts/api/serverFolders.ts
new file mode 100644
index 000000000..fd987dee0
--- /dev/null
+++ b/resources/scripts/api/serverFolders.ts
@@ -0,0 +1,28 @@
+import http from "@/api/http";
+
+export interface ServerFolder {
+  id: number;
+  name: string;
+}
+const endpoint = "/api/client/account/server-folders";
+
+export async function getServerFolders(): Promise<ServerFolder[]> {
+  const { data } = await http.get(endpoint);
+  return data.data;
+}
+export async function saveServerFolder(
+  name: string,
+  id?: number,
+): Promise<void> {
+  if (id === undefined) await http.post(endpoint, { name });
+  else await http.put(`${endpoint}/${id}`, { name });
+}
+export async function deleteServerFolder(id: number): Promise<void> {
+  await http.delete(`${endpoint}/${id}`);
+}
+export async function assignServerFolder(
+  uuid: string,
+  folderId: number | null,
+): Promise<void> {
+  await http.put(`${endpoint}/servers/${uuid}`, { folder_id: folderId });
+}
